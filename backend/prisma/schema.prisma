// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Card {
  id            Int      @id
  name          String
  type          String
  frameType     String?
  desc          String   @db.Text
  atk           Int?
  def           Int?
  level         Int?
  race          String?
  attribute     String?
  archetype     String?
  // Source addresses on YGOPRODeck just to download the images
  // NO HOTLINKING, CAN'T BE USED AS DIRECT SOURCES (risk of IP block from the API)
  imageUrl      String?
  imageSmallUrl String?
  updatedAt DateTime @updatedAt

  deckCards DeckCard[]
  sidePatternCards SidePatternCard[]
  wthTargets WthEntry[] @relation("WthTarget")
  WthResponses WthResponse[] @relation("WthResponse")
  comboCards ComboCard[]

  @@index([name])
}

model User {
  id              String   @id @default(cuid())
  email           String?  @unique
  username        String?  @unique
  displayName     String?
  passwordHash    String?
  googleId        String?  @unique
  stripeAccountId String? @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  decks           Deck[]
  wthGuides       WthGuide[]
  combos          Combo[]
  playlists       Playlist[]
  purchases       Purchase[]
}

enum DeckSection {
  MAIN
  EXTRA
  SIDE
}

model Deck {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  archetype   String?
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cards DeckCard[]
  sidePatterns SidePattern[]

  @@index([ownerId])
}

model DeckCard {
  id       String      @id @default(cuid())
  deckId   String
  deck     Deck        @relation(fields: [deckId], references: [id], onDelete: Cascade)
  cardId   Int
  card     Card        @relation(fields: [cardId], references: [id])
  section  DeckSection
  quantity Int         @default(1)
  position Int         @default(0)

  @@unique([deckId, cardId, section])
  @@index([deckId])
}

enum SwapDirection {
  OUT
  IN
}

// "Against deck X: take these cards out and put these cards in."
model SidePattern {
  id               String   @id @default(cuid())
  deckId           String
  deck             Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  opponentDeckName String
  notes            String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  cards SidePatternCard[]

  @@unique([deckId, opponentDeckName])
  @@index([deckId])
}

model SidePatternCard {
  id            String        @id @default(cuid())
  sidePatternId String
  SidePattern   SidePattern   @relation(fields: [sidePatternId], references: [id], onDelete: Cascade)
  cardId        Int
  card          Card          @relation(fields: [cardId], references: [id])
  direction     SwapDirection
  quantity      Int           @default(1)
  // Display order inside its own list
  position      Int           @default(0)

  @@unique([sidePatternId, cardId, direction])
  @@index([sidePatternId])
}

model WthGuide {
  id               String     @id @default(cuid())
  ownerId          String
  owner            User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  opponentDeckName String
  notes            String?
  entries          WthEntry[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([ownerId, opponentDeckName])
}

model WthEntry {
  id           String        @id @default(cuid())
  guideId      String
  guide        WthGuide      @relation(fields: [guideId], references: [id], onDelete: Cascade)
  targetCardId Int
  targetCard   Card          @relation("WthTarget", fields: [targetCardId], references: [id])
  notes        String?
  position     Int           @default(0)
  responses    WthResponse[]

  @@unique([guideId, targetCardId])
}

model WthResponse {
  id       String   @id @default(cuid())
  entryId  String
  entry    WthEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  cardId   Int
  card     Card     @relation("WthResponse", fields: [cardId], references: [id])
  position Int      @default(0)

  @@unique([entryId, cardId])
}

model Combo {
  id           String      @id @default(cuid())
  ownerId      String
  owner        User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  // Card ids of the starting hand (repeated for more copies)
  startingHand Int[]
  // The steps validated by the backend at every save
  steps        Json        @default("[]")
  /// Copy of steps.length so the list does not need to read the Json
  stepCount    Int         @default(0)
  cards        ComboCard[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  playlists    PlaylistCombo[]

  @@index([ownerId])
}

model ComboCard {
  id       String      @id @default(cuid())
  comboId  String
  combo    Combo       @relation(fields: [comboId], references: [id], onDelete: Cascade)
  cardId   Int
  card     Card        @relation(fields: [cardId], references: [id])
  section  DeckSection
  quantity Int
  position Int         @default(0)

  @@unique([comboId, cardId, section])
}

model Playlist {
  id          String          @id @default(cuid())
  ownerId     String?
  owner       User?           @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  name        String
  description String?
  combos      PlaylistCombo[]
  isForSale   Boolean         @default(false)
  priceCents  Int?            // In Euro cents, we don't use decimals
  snapshot    Json?           // Frozen copy, only if the playlist had buyers when it was deleted
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  purchases   Purchase[]

  @@unique([ownerId, name])
}

model PlaylistCombo {
  id         String   @id @default(cuid())
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  comboId    String
  combo      Combo    @relation(fields: [comboId], references: [id], onDelete: Cascade)
  position   Int

  @@unique([playlistId, comboId])
}

model Purchase {
  id              String   @id @default(cuid())
  buyerId         String
  buyer           User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  playlistId      String
  playlist        Playlist @relation(fields: [playlistId], references: [id], onDelete: Restrict)
  stripeSessionId String   @unique
  amountCents     Int
  currency        String
  feeCents        Int      @default(0) // Fee imposed by the platform on this purchase
  createdAt       DateTime @default(now())

  @@unique([buyerId, playlistId])
  @@index([playlistId])
}