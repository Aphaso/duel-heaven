// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Card {
  id            Int      @id
  name          String
  type          String
  frameType     String?
  desc          String   @db.Text
  atk           Int?
  def           Int?
  level         Int?
  race          String?
  attribute     String?
  archetype     String?
  // Source addresses on YGOPRODeck just to download the images
  // NO HOTLINKING, CAN'T BE USED AS DIRECT SOURCES (risk of IP block from the API)
  imageUrl      String?
  imageSmallUrl String?
  updatedAt DateTime @updatedAt

  deckCards DeckCard[]

  @@index([name])
}

model User {
  id          String   @id @default(cuid())
  email       String?  @unique
  username    String?  @unique
  displayName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  decks Deck[]
}

enum DeckSection {
  MAIN
  EXTRA
  SIDE
}

model Deck {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  archetype   String?
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cards DeckCard[]

  @@index([ownerId])
}

model DeckCard {
  id       String      @id @default(cuid())
  deckId   String
  deck     Deck        @relation(fields: [deckId], references: [id], onDelete: Cascade)
  cardId   Int
  card     Card        @relation(fields: [cardId], references: [id])
  section  DeckSection
  quantity Int         @default(1)

  @@unique([deckId, cardId, section])
  @@index([deckId])
}