// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Card {
  id            Int      @id
  name          String
  type          String
  frameType     String?
  desc          String   @db.Text
  atk           Int?
  def           Int?
  level         Int?
  race          String?
  attribute     String?
  archetype     String?
  // Source addresses on YGOPRODeck just to download the images
  // NO HOTLINKING, CAN'T BE USED AS DIRECT SOURCES (risk of IP block from the API)
  imageUrl      String?
  imageSmallUrl String?
  updatedAt DateTime @updatedAt

  deckCards DeckCard[]
  sidePatternCards SidePatternCard[]
  wthTargets WthEntry[] @relation("WthTarget")
  WthResponses WthResponse[] @relation("WthResponse")

  @@index([name])
}

model User {
  id          String   @id @default(cuid())
  email       String?  @unique
  username    String?  @unique
  displayName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  decks       Deck[]
  wthGuides   WthGuide[]
}

enum DeckSection {
  MAIN
  EXTRA
  SIDE
}

model Deck {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  archetype   String?
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cards DeckCard[]
  sidePatterns SidePattern[]

  @@index([ownerId])
}

model DeckCard {
  id       String      @id @default(cuid())
  deckId   String
  deck     Deck        @relation(fields: [deckId], references: [id], onDelete: Cascade)
  cardId   Int
  card     Card        @relation(fields: [cardId], references: [id])
  section  DeckSection
  quantity Int         @default(1)
  position Int         @default(0)

  @@unique([deckId, cardId, section])
  @@index([deckId])
}

enum SwapDirection {
  OUT
  IN
}

// "Against deck X: take these cards out and put these cards in."
model SidePattern {
  id               String   @id @default(cuid())
  deckId           String
  deck             Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  opponentDeckName String
  notes            String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  cards SidePatternCard[]

  @@unique([deckId, opponentDeckName])
  @@index([deckId])
}

model SidePatternCard {
  id            String        @id @default(cuid())
  sidePatternId String
  SidePattern   SidePattern   @relation(fields: [sidePatternId], references: [id], onDelete: Cascade)
  cardId        Int
  card          Card          @relation(fields: [cardId], references: [id])
  direction     SwapDirection
  quantity      Int           @default(1)
  // Display order inside its own list
  position      Int           @default(0)

  @@unique([sidePatternId, cardId, direction])
  @@index([sidePatternId])
}

model WthGuide {
  id               String     @id @default(cuid())
  ownerId          String
  owner            User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  opponentDeckName String
  notes            String?
  entries          WthEntry[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([ownerId, opponentDeckName])
}

model WthEntry {
  id           String        @id @default(cuid())
  guideId      String
  guide        WthGuide      @relation(fields: [guideId], references: [id], onDelete: Cascade)
  targetCardId Int
  targetCard   Card          @relation("WthTarget", fields: [targetCardId], references: [id])
  notes        String?
  position     Int           @default(0)
  responses    WthResponse[]

  @@unique([guideId, targetCardId])
}

model WthResponse {
  id       String   @id @default(cuid())
  entryId  String
  entry    WthEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  cardId   Int
  card     Card     @relation("WthResponse", fields: [cardId], references: [id])
  position Int      @default(0)

  @@unique([entryId, cardId])
}